[submodule "ros2/src/opennav_coverage"]
	path = ros2/src/opennav_coverage
	url = https://github.com/open-navigation/opennav_coverage.git
	branch = main
[submodule "ros2/src/external/universal-gnss"]
	path = ros2/src/external/universal-gnss
	# Follows Pepeuch/universal-gnss directly. The mowglinext fork's main had gone
	# stale (its fixes for issue #395 are upstream in Pepeuch main), and fixes such as
	# Pepeuch/universal-gnss#7 (frozen lat/lon with NMEA-only receivers) land there first.
	url = https://github.com/Pepeuch/universal-gnss.git
	branch = main